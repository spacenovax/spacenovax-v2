# Gateway only — do not reuse SpaceNovaX application, PostgreSQL, wallet, or admin secrets.
PORT=10100
COMMUNITY_NODE_SIGNING_KEY=replace-with-a-long-random-server-only-value
COMMUNITY_NODE_ADMIN_KEY=replace-with-a-separate-long-random-admin-value

# Agent only — issued once after /v1/nodes/register. Do not share these values.
COMMUNITY_NODE_URL=http://127.0.0.1:10100
COMMUNITY_NODE_ID=
COMMUNITY_NODE_SECRET=
